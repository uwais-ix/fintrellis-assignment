# Development defaults. Leave mocks off to use the Spring API.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api

# Local Keycloak realm. The issuer must match the token issuer exactly.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/journal
VITE_OIDC_CLIENT_ID=journal-web
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
