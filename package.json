{
  "name": "fintrellis-journal",
  "private": true,
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:mock": "pnpm --filter frontend dev:mock",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm --filter frontend test",
    "test:e2e": "playwright test",
    "verify": "bash scripts/verify.sh",
    "quality:up": "docker compose --profile quality up -d",
    "quality:down": "docker compose --profile quality down",
    "quality:scan": "bash scripts/sonar-scan.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
